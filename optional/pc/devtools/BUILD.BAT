@ECHO OFF
REM MD.js Ultra Phase 4N: Small-C on XT and 286, no NASM.
REM Run BUILD HELLO from writable B:. Output HELLO.EXE.
IF "%1"=="" GOTO USAGE
B:
CC %1
IF ERRORLEVEL 1 GOTO FAIL
ASM %1
IF ERRORLEVEL 1 GOTO FAIL
YLINK %1.OBJ,CLIB.LIB -e=%1.EXE
IF ERRORLEVEL 1 GOTO FAIL
ECHO BUILD OK: %1.EXE
GOTO END
:USAGE
ECHO Usage: BUILD HELLO  (source HELLO.C)
GOTO END
:FAIL
ECHO BUILD FAILED - check compiler output
:END
